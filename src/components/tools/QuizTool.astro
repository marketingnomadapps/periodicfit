---
import Icon from '../Icon.astro';
import { QUESTIONS } from '../../data/quiz';
---
<div class="quiz grid gap-4 lg:grid-cols-[1.05fr_1fr] lg:gap-5">
  <form class="quiz-form rounded-[28px] border border-white/10 bg-surface/80 p-5 md:p-7" novalidate>
    <div class="flex items-center justify-between text-xs text-muted">
      <span>Question <span data-q-now>1</span> / {QUESTIONS.length}</span>
      <button type="button" data-q-restart class="hidden items-center gap-1 hover:text-primary"><Icon name="rotate-ccw" size={13} /> Restart</button>
    </div>
    <div class="mt-3 h-1 overflow-hidden rounded-full bg-white/10"><div data-q-bar class="h-full w-0 rounded-full bg-primary transition-[width] duration-500"></div></div>
    <div class="relative mt-6">
      {QUESTIONS.map((q, i) => (
        <fieldset class="quiz-step" data-step={i} hidden={i !== 0}>
          <legend class="font-display text-2xl font-bold tracking-tight md:text-3xl">{q.q}</legend>
          <div class="mt-5 grid gap-2.5">
            {q.options.map((o, k) => (
              <label class="quiz-opt group cursor-pointer">
                <input type="radio" name={`q${i + 1}`} value={k} class="peer sr-only" />
                <span class="flex items-center gap-3 rounded-2xl border border-line bg-night/50 px-4 py-3.5 transition-all peer-checked:border-primary peer-checked:bg-primary/10 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-primary group-hover:border-primary/50">
                  <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-surface-2 text-primary"><Icon name={o.icon} size={18} /></span>
                  <span class="font-medium">{o.label}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
    </div>
    <button type="button" data-q-back class="mt-5 hidden items-center gap-1.5 text-sm text-muted hover:text-primary"><Icon name="arrow-left" size={14} /> Back</button>
  </form>

  <div class="tool-result relative overflow-hidden rounded-[28px] border border-primary/25 bg-[linear-gradient(160deg,rgb(198_255_61/0.10),rgb(23_25_30/0.9)_45%)] p-5 md:p-7" aria-live="polite">
    <div data-q-empty>
      <p class="eyebrow">(Your result)</p>
      <p class="mt-4 font-display text-3xl font-bold tracking-tight">Answer 6 quick questions.</p>
      <p class="mt-2 text-muted">We'll match you with one of five training personalities, plus the plan style that suits you.</p>
      <ul class="mt-6 grid grid-cols-2 gap-2 text-sm text-ink/80">
        <li class="rounded-xl bg-night/50 px-3 py-2">The Builder</li><li class="rounded-xl bg-night/50 px-3 py-2">The Burner</li>
        <li class="rounded-xl bg-night/50 px-3 py-2">The Flow Seeker</li><li class="rounded-xl bg-night/50 px-3 py-2">The Home Hero</li>
        <li class="rounded-xl bg-night/50 px-3 py-2">The Fuel Strategist</li>
      </ul>
    </div>
    <div data-q-result hidden>
      <p class="eyebrow">(You are)</p>
      <p class="mt-3 t-result-num text-5xl md:text-6xl" data-out="name">–</p>
      <p class="mt-2 text-lg text-primary" data-out="tagline"></p>
      <p class="mt-4 text-ink/80" data-out="about"></p>
      <ul class="mt-5 flex flex-wrap gap-2" data-out="traits"></ul>
      <div class="mt-6 rounded-2xl border border-line bg-night/55 p-4">
        <p class="text-xs text-muted">Best fit for you</p>
        <p class="mt-1 font-semibold"><a data-out="service" href="#" class="hover:text-primary"></a></p>
        <p class="mt-1 text-sm text-muted">Suggested split: <span data-out="split"></span></p>
      </div>
      <p class="mt-5 text-xs text-muted">Your mix</p>
      <ul class="mt-2 space-y-1.5" data-out="mix"></ul>
    </div>
  </div>
</div>

<script>
  import { QUESTIONS, PERSONAS, type Persona } from '../../data/quiz';
  import { emitResult, shareUrl, restoreFromUrl } from '../../scripts/tools/common';
  const root = document.querySelector<HTMLElement>('[data-tool="fitness-personality-quiz"]');
  const form = root?.querySelector<HTMLFormElement>('form');
  if (root && form) {
    const steps = Array.from(form.querySelectorAll<HTMLElement>('.quiz-step'));
    const bar = form.querySelector<HTMLElement>('[data-q-bar]')!;
    const nowEl = form.querySelector<HTMLElement>('[data-q-now]')!;
    const back = form.querySelector<HTMLElement>('[data-q-back]')!;
    const restart = form.querySelector<HTMLElement>('[data-q-restart]')!;
    let current = 0;
    const answers = () => QUESTIONS.map((_, i) => (form.querySelector<HTMLInputElement>(`input[name="q${i + 1}"]:checked`)?.value));
    const show = (i: number) => {
      current = i;
      steps.forEach((s, k) => (s.hidden = k !== i));
      nowEl.textContent = String(Math.min(i + 1, steps.length));
      back.classList.toggle('hidden', i === 0); back.classList.toggle('inline-flex', i > 0);
      steps[i]?.animate([{ opacity: 0, transform: 'translateX(24px)' }, { opacity: 1, transform: 'none' }], { duration: 350, easing: 'cubic-bezier(.16,1,.3,1)' });
    };
    const result = () => {
      const a = answers();
      bar.style.width = `${(a.filter(Boolean).length / QUESTIONS.length) * 100}%`;
      if (a.some((x) => x === undefined)) return;
      const score: Record<Persona, number> = { builder: 0, burner: 0, flow: 0, home: 0, fuel: 0 };
      a.forEach((v, i) => Object.entries(QUESTIONS[i].options[Number(v)].score).forEach(([k, n]) => (score[k as Persona] += n!)));
      const total = Object.values(score).reduce((x, y) => x + y, 0) || 1;
      const ranked = (Object.entries(score) as [Persona, number][]).sort((x, y) => y[1] - x[1]);
      const p = PERSONAS[ranked[0][0]];
      const $ = (s: string) => root.querySelector<HTMLElement>(`[data-out="${s}"]`)!;
      root.querySelector<HTMLElement>('[data-q-empty]')!.hidden = true;
      const res = root.querySelector<HTMLElement>('[data-q-result]')!; res.hidden = false;
      res.animate([{ opacity: 0, transform: 'scale(.96)' }, { opacity: 1, transform: 'none' }], { duration: 500, easing: 'cubic-bezier(.16,1,.3,1)' });
      $('name').textContent = p.name; $('tagline').textContent = p.tagline; $('about').textContent = p.about;
      $('traits').innerHTML = p.traits.map((t) => `<li class="rounded-pill border border-primary/40 bg-primary/10 px-3 py-1 text-xs text-primary">${t}</li>`).join('');
      const link = $('service') as HTMLAnchorElement; link.textContent = `${p.serviceName} →`; link.href = `/services/${p.service}`;
      $('split').textContent = p.split;
      $('mix').innerHTML = ranked.map(([k, v]) => `<li class="text-xs"><div class="flex justify-between text-ink/80"><span>${PERSONAS[k].name}</span><span>${Math.round(v / total * 100)}%</span></div><div class="mt-1 h-1.5 overflow-hidden rounded-full bg-white/10"><div class="h-full rounded-full bg-primary" style="width:${v / total * 100}%"></div></div></li>`).join('');
      restart.classList.remove('hidden'); restart.classList.add('inline-flex');
      emitResult(form, {
        tool: 'Fitness Personality', kicker: 'My training personality', hero: p.name, heroUnit: p.tagline,
        list: [...p.traits, `Best fit: ${p.serviceName}`],
        shareText: `I'm ${p.name} 💪 Take the 60-second PeriodicFit fitness personality quiz and find yours:`,
        url: shareUrl(form),
      });
    };
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (!t.name.startsWith('q')) return;
      const i = Number(t.name.slice(1)) - 1;
      result();
      if (i === current && current < steps.length - 1) setTimeout(() => show(current + 1), 220);
    });
    back.addEventListener('click', () => show(Math.max(0, current - 1)));
    restart.addEventListener('click', () => { form.reset(); root.querySelector<HTMLElement>('[data-q-empty]')!.hidden = false; root.querySelector<HTMLElement>('[data-q-result]')!.hidden = true; restart.classList.add('hidden'); bar.style.width = '0'; show(0); });
    if (restoreFromUrl(form)) { result(); show(steps.length - 1); }
  }
</script>
