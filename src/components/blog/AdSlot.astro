---
/**
 * Reserved ad space. Renders NOTHING while ADS.ADSENSE_ENABLED is false.
 * When enabled, a fixed min-height prevents layout shift. Ads load only after cookie consent (consent.ts).
 */
import { ADS } from '../../config/site';
interface Props { slot: 'below-title' | 'mid-article' | 'end-article' | 'sidebar'; adSlotId?: string }
const { slot, adSlotId = '' } = Astro.props; // TODO: real AdSense slot IDs per position
const minH = slot === 'sidebar' ? 'min-h-[600px]' : 'min-h-[280px]';
---
{ADS.ADSENSE_ENABLED && ADS.clientId && (
  <aside class:list={['ad-slot my-8 flex items-center justify-center overflow-hidden rounded-xl bg-paper-2', minH]} aria-label="Advertisement" data-ad-slot-name={slot}>
    <ins class="adsbygoogle block w-full" style="display:block" data-ad-client={ADS.clientId} data-ad-slot={adSlotId} data-ad-format="auto" data-full-width-responsive="true"></ins>
  </aside>
)}
