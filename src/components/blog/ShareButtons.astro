---
interface Props { url: string; title: string }
const { url, title } = Astro.props;
const u = encodeURIComponent(url), t = encodeURIComponent(title);
const links = [
  { label: 'WhatsApp', href: `https://wa.me/?text=${t}%20${u}` },
  { label: 'X', href: `https://twitter.com/intent/tweet?text=${t}&url=${u}` },
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
];
---
<div class="share-row flex flex-wrap items-center gap-2" data-share-url={url}>
  <span class="mr-1 text-sm font-semibold text-text">Share:</span>
  {links.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer" class="rounded-pill border border-[#D9DCE1] px-3 py-1.5 text-sm text-text transition-colors hover:border-text">{l.label}</a>)}
  <button type="button" data-copy class="rounded-pill border border-[#D9DCE1] px-3 py-1.5 text-sm text-text transition-colors hover:border-text">Copy link</button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.share-row').forEach((row) => {
    row.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(row.dataset.shareUrl!); btn.textContent = 'Copied ✓'; } catch { btn.textContent = 'Copy failed'; }
      setTimeout(() => (btn.textContent = 'Copy link'), 2000);
    });
  });
</script>
