---
import { Image } from 'astro:assets';
import { STEPS } from '../../data/home';
---
<section id="how" data-section-bg="#0E0F12" class="how relative py-24 [.js-motion_&]:py-0">
  <div class="how-pin [.js-motion_&]:flex [.js-motion_&]:min-h-[100svh] [.js-motion_&]:flex-col [.js-motion_&]:justify-center [.js-motion_&]:py-20 md:[.js-motion_&]:py-24">
    <div class="container-pf w-full">
      <div class="mb-8 flex flex-col justify-between gap-5 md:mb-14 md:flex-row md:items-end">
        <div>
          <p class="eyebrow mb-4">(How it works)</p>
          <h2 class="split-heading text-[clamp(2.4rem,6vw,5rem)] font-bold leading-[0.95] tracking-[-0.03em]">Four steps.<br />Zero guesswork.</h2>
        </div>
        <ol class="how-progress hidden gap-2 [.js-motion_&]:flex" aria-hidden="true">
          {STEPS.map((s) => (
            <li class="w-16 md:w-20">
              <span class="font-display text-xs text-muted">{s.n}</span>
              <span class="mt-2 block h-0.5 overflow-hidden rounded bg-line"><span class="how-bar block h-full origin-left scale-x-0 bg-primary"></span></span>
            </li>
          ))}
        </ol>
      </div>

      <ol class="how-steps space-y-16 md:space-y-24">
        {STEPS.map((s, i) => (
          <li class="how-step grid items-center gap-5 md:grid-cols-12 md:gap-12">
            <div class="how-text md:col-span-5">
              <span class="block font-display text-[clamp(3rem,10vw,9rem)] font-bold leading-none tracking-[-0.05em] text-primary">{s.n}</span>
              <h3 class="mt-2 text-2xl font-bold md:mt-4 md:text-4xl">{s.title}</h3>
              <p class="mt-2 max-w-md text-muted md:mt-4 md:text-lg">{s.text}</p>
            </div>
            <div class="how-img relative aspect-[4/3] overflow-hidden rounded-card md:col-span-7 md:aspect-[16/10]">
              <Image src={s.img} alt={s.alt} widths={[600, 1000, 1400]} sizes="(min-width: 768px) 58vw, 100vw" quality={70} class="how-photo h-full w-full scale-110 object-cover" />
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  /* Pinned mode (desktop + motion): steps stack on top of each other and swap on scroll */
  :global(.how.pin-mode) .how-steps { position: relative; height: min(64svh, 560px); }
  :global(.how.pin-mode) .how-steps > * + * { margin-top: 0; }
  :global(.how.pin-mode) .how-step { position: absolute; inset: 0; }
  @media (min-width: 768px) {
    :global(.how.pin-mode) .how-img { height: 100%; aspect-ratio: auto; }
  }
  @media (max-width: 767px) {
    :global(.how.pin-mode) .how-step { display: flex; flex-direction: column; align-items: stretch; }
    :global(.how.pin-mode) .how-img { flex: 1; min-height: 0; aspect-ratio: auto; }
  }
</style>
