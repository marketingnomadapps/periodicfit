---
import PostCard from './PostCard.astro';
import CtaBox from './CtaBox.astro';
import type { Post } from '../../lib/posts';
interface Props {
  posts: Post[];                       // posts on this page
  all: Post[];                         // all posts (for search)
  categories: { name: string; slug: string; count: number }[];
  activeCategory?: string;
  heading: string;
  intro: string;
  eyebrow?: string;
  page: { current: number; last: number; base: string };  // base: "/blog" or "/blog/category/x"
  showFeatured?: boolean;
  crumbs: { label: string; href?: string }[];
}
const { posts, all, categories, activeCategory, heading, intro, eyebrow = 'The PeriodicFit Journal', page, showFeatured = false, crumbs } = Astro.props;
const featured = showFeatured ? posts[0] : undefined;
const rest = showFeatured ? posts.slice(1) : posts;
const href = (n: number) => (n === 1 ? page.base : page.base === '/blog' ? `/blog/page/${n}` : `${page.base}/${n}`);
const searchIndex = all.map((p) => ({ t: p.title, e: p.excerpt, c: p.category.name, s: p.slug, d: p.date.toISOString().slice(0, 10), r: p.readingTime }));
---
<section class="border-b border-[#E6E8EC] bg-paper pb-10 pt-10 md:pt-14">
  <div class="container-pf">
    <nav aria-label="Breadcrumb" class="mb-5 text-xs text-text-muted">
      <ol class="flex flex-wrap gap-1.5">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <li aria-hidden="true">/</li>}
            <li>{c.href ? <a href={c.href} class="hover:text-text hover:underline">{c.label}</a> : <span aria-current="page" class="text-text">{c.label}</span>}</li>
          </>
        ))}
      </ol>
    </nav>
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="mb-3 font-display text-xs font-semibold uppercase tracking-[0.2em] text-text-muted">{eyebrow}</p>
        <h1 data-reveal class="max-w-3xl font-display text-[clamp(2.4rem,6vw,4.75rem)] font-bold leading-[0.98] tracking-[-0.035em] text-text">{heading}</h1>
        <p data-reveal class="mt-4 max-w-xl text-lg text-text-muted">{intro}</p>
      </div>
      <label class="relative w-full md:w-80">
        <span class="sr-only">Search articles</span>
        <input id="blog-search" type="search" placeholder="Search articles…" autocomplete="off" class="w-full rounded-pill border border-[#D9DCE1] bg-white py-3 pl-11 pr-4 text-text placeholder:text-text-muted focus:border-text focus:outline-none" />
        <svg class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-text-muted" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
      </label>
    </div>
    <nav aria-label="Categories" class="mt-8 flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none]">
      <a href="/blog" class:list={['shrink-0 rounded-pill border px-4 py-2 text-sm font-medium transition-colors', !activeCategory ? 'border-night bg-night text-primary' : 'border-[#D9DCE1] text-text hover:border-text']}>All</a>
      {categories.map((c) => (
        <a href={`/blog/category/${c.slug}`} aria-current={c.slug === activeCategory ? 'page' : undefined} class:list={['shrink-0 rounded-pill border px-4 py-2 text-sm font-medium transition-colors', c.slug === activeCategory ? 'border-night bg-night text-primary' : 'border-[#D9DCE1] text-text hover:border-text']}>{c.name}{c.count ? <span class="ml-1.5 text-xs opacity-60">{c.count}</span> : null}</a>
      ))}
    </nav>
  </div>
</section>

<section class="bg-paper py-12 md:py-16">
  <div class="container-pf">
    <!-- Search results (client side) -->
    <div id="search-results" hidden>
      <p class="mb-6 text-sm text-text-muted" aria-live="polite"><span id="search-count">0</span> results</p>
      <ul id="search-list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></ul>
    </div>

    <div id="listing">
      {posts.length === 0 && (
        <div class="rounded-[22px] border border-dashed border-[#D9DCE1] p-12 text-center">
          <p class="text-4xl">✍️</p>
          <p class="mt-3 font-display text-2xl font-bold text-text">New articles are on the way.</p>
          <p class="mt-2 text-text-muted">Meanwhile, try our <a href="/tools" class="font-semibold text-text underline decoration-primary decoration-[3px] underline-offset-4">free fitness tools</a>.</p>
        </div>
      )}
      {featured && (
        <div class="mb-6" data-reveal><PostCard post={featured} large /></div>
      )}
      {rest.length > 0 && (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {rest.map((p, i) => <li data-reveal data-reveal-delay={String((i % 3) * 0.06)}><PostCard post={p} /></li>)}
        </ul>
      )}

      {page.last > 1 && (
        <nav aria-label="Pagination" class="mt-12 flex items-center justify-center gap-2">
          {page.current > 1 && <a href={href(page.current - 1)} rel="prev" class="rounded-pill border border-[#D9DCE1] px-4 py-2 text-sm text-text hover:border-text">← Newer</a>}
          {Array.from({ length: page.last }, (_, i) => i + 1).map((n) => (
            <a href={href(n)} aria-current={n === page.current ? 'page' : undefined} class:list={['grid h-10 w-10 place-items-center rounded-full text-sm font-semibold', n === page.current ? 'bg-night text-primary' : 'border border-[#D9DCE1] text-text hover:border-text']}>{n}</a>
          ))}
          {page.current < page.last && <a href={href(page.current + 1)} rel="next" class="rounded-pill border border-[#D9DCE1] px-4 py-2 text-sm text-text hover:border-text">Older →</a>}
        </nav>
      )}
    </div>

    <CtaBox title="Reading is step one." text="Turn what you learn into a plan built for your body, food and schedule. Free first call." />
  </div>
</section>

<script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />
<script>
  const input = document.getElementById('blog-search') as HTMLInputElement | null;
  const index = JSON.parse(document.getElementById('search-index')?.textContent || '[]') as { t: string; e: string; c: string; s: string; d: string; r: number }[];
  const results = document.getElementById('search-results')!;
  const listing = document.getElementById('listing')!;
  const list = document.getElementById('search-list')!;
  const count = document.getElementById('search-count')!;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    if (q.length < 2) { results.hidden = true; listing.hidden = false; return; }
    const words = q.split(/\s+/);
    const hits = index.filter((p) => words.every((w) => `${p.t} ${p.e} ${p.c}`.toLowerCase().includes(w)));
    count.textContent = String(hits.length);
    // Every value is escaped before it touches the DOM
    list.innerHTML = hits.map((p) => `<li><a href="/blog/${encodeURIComponent(p.s)}" class="block h-full rounded-[22px] border border-[#E6E8EC] bg-white p-5 hover:shadow-lg"><span class="text-xs font-semibold uppercase tracking-[0.12em] text-text-muted">${esc(p.c)}</span><span class="mt-2 block font-display text-lg font-bold text-text">${esc(p.t)}</span><span class="mt-2 block text-sm text-text-muted">${esc(p.e)}</span><span class="mt-3 block text-xs text-text-muted">${esc(p.d)} · ${p.r} min read</span></a></li>`).join('') || '<li class="text-text-muted">No articles found. Try another word.</li>';
    results.hidden = false; listing.hidden = true;
  });
</script>
