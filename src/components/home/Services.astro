---
/**
 * Services as stacking parallax cards: each card sticks, the next one slides over it,
 * the covered card scales back and dims, and every photo drifts inside its frame.
 * Uses CSS position: sticky (smooth, no JS pinning) + GSAP scrub for transform/opacity.
 */
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { SERVICES } from '../../config/site';
import { SERVICE_IMAGES } from '../../data/images';

const total = String(SERVICES.length).padStart(2, '0');
---
<section id="services" data-section-bg="#121418" class="relative pb-16 pt-24 md:pb-24 md:pt-36">
  <div class="container-pf">
    <div class="mb-12 grid gap-6 md:mb-16 md:grid-cols-2 md:items-end">
      <div>
        <p class="eyebrow mb-4">(What we do)</p>
        <h2 class="split-heading text-[clamp(2.4rem,6vw,5rem)] font-bold leading-[0.95] tracking-[-0.03em]">Everything you need.<br />One coaching team.</h2>
      </div>
      <p class="max-w-sm text-muted md:justify-self-end">Training, nutrition and recovery under one roof, so your workouts and your meals finally work together.</p>
    </div>

    <ol class="svc-stack relative" role="list">
      {SERVICES.map((s, i) => {
        const img = SERVICE_IMAGES[s.slug];
        return (
          <li class="svc-card sticky mb-[8svh] last:mb-0" style={`top: calc(5.5rem + ${i * 12}px)`}>
            <article class="svc-inner relative h-[72svh] min-h-[460px] origin-top overflow-hidden rounded-[28px] bg-surface will-change-transform md:h-[74vh] md:min-h-[520px]">
              <!-- Photo with inner parallax -->
              <div class="svc-media absolute inset-x-0 -inset-y-[12%]">
                <Image src={img.src} alt={img.alt} widths={[600, 1000, 1600]} sizes="(min-width: 1280px) 1216px, 100vw" quality={68} class="h-full w-full object-cover" />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-night via-night/55 to-night/10 md:bg-gradient-to-r md:from-night/95 md:via-night/55 md:to-transparent"></div>
              <!-- Darkens as the next card covers this one -->
              <div class="svc-shade pointer-events-none absolute inset-0 bg-night opacity-0"></div>

              <div class="svc-content relative flex h-full flex-col justify-between p-6 md:p-12">
                <div class="flex items-center justify-between">
                  <span class="grid h-12 w-12 place-items-center rounded-full bg-primary text-night md:h-14 md:w-14"><Icon name={s.icon} size={24} /></span>
                  <span class="font-display text-sm text-ink/70"><span class="text-ink">{String(i + 1).padStart(2, '0')}</span> / {total}</span>
                </div>
                <div class="max-w-xl">
                  <h3 class="font-display text-[clamp(2rem,5vw,4.25rem)] font-bold leading-[0.98] tracking-[-0.03em]">{s.name}</h3>
                  <p class="mt-4 max-w-md text-base text-ink/80 md:text-lg">{s.pitch}</p>
                  <ul class="mt-5 flex flex-wrap gap-2">
                    {s.points.map((pt) => (
                      <li class="inline-flex items-center gap-1.5 rounded-pill border border-white/15 bg-night/40 px-3 py-1.5 text-xs text-ink md:text-sm">
                        <Icon name="check" size={14} class="text-primary" />{pt}
                      </li>
                    ))}
                  </ul>
                  <div class="mt-7 flex flex-wrap gap-3">
                    <a href={`/services/${s.slug}`} class="btn-primary">Explore {s.short} <Icon name="arrow-right" size={16} /></a>
                  </div>
                </div>
              </div>
            </article>
          </li>
        );
      })}
    </ol>
  </div>
</section>
