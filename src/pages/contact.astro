---
import { Image } from 'astro:assets';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Icon from '../components/Icon.astro';
import InquiryForm from '../components/InquiryForm.astro';
import FAQ from '../components/FAQ.astro';
import { CONTACT, SITE } from '../config/site';
// Temporary photos (Unsplash). TODO: replace with own images.
import videoCall from '../assets/images/contact/video-call.jpg';
import laptops from '../assets/images/contact/laptops.jpg';
import stethoscope from '../assets/images/contact/stethoscope.jpg';

const wa = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(CONTACT.whatsappMessage)}`;
const methods = [
  { e: '💬', icon: 'message-circle', t: 'WhatsApp', d: 'Fastest reply', v: CONTACT.phoneDisplay, href: wa, ext: true },
  { e: '✉️', icon: 'mail', t: 'Email', d: 'For detailed questions', v: CONTACT.email, href: `mailto:${CONTACT.email}`, ext: false },
  { e: '📞', icon: 'phone', t: 'Call us', d: 'Talk to the team', v: CONTACT.phoneDisplay, href: `tel:${CONTACT.phone}`, ext: false },
  { e: '🕘', icon: 'clock', t: 'Support hours', d: 'We reply within 24 h', v: CONTACT.hours, href: '', ext: false },
];
const next = [
  { e: '📩', t: 'We reply within 24 hours', d: 'A coach reads your message and gets back to you on your preferred channel.' },
  { e: '📹', t: 'Free 15–20 min call', d: 'We talk through your goals, history and schedule. No payment, no pressure.' },
  { e: '🗓️', t: 'Your plan in 48 hours', d: 'If it’s a fit, your custom plan arrives within two days of signing up.' },
];
const faq = [
  { q: 'How quickly will you reply?', a: 'Within 24 hours on working days, usually much sooner on WhatsApp.' },
  { q: 'Is the consultation really free?', a: 'Yes. The first call is free and there is no obligation to sign up.' },
  { q: 'Can I talk to a dietitian before joining?', a: 'Yes. Choose "Online Dietitian Consultation" in the form and we will match you with a dietitian.' },
  { q: 'Do you coach clients outside India?', a: 'Coaching is fully online, so you can join from anywhere with an internet connection.' }, // TODO: confirm markets
];
const ld = { '@context': 'https://schema.org', '@type': 'ContactPage', name: `Contact ${SITE.name}`, url: `${SITE.url}/contact` };
---
<MarketingLayout title="Contact Us" description="Talk to a PeriodicFit coach. Book a free consultation, message us on WhatsApp or email. We reply within 24 hours.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />

  <section class="relative overflow-hidden pb-16 pt-28 md:pt-32">
    <div class="pointer-events-none absolute -right-40 top-0 h-[620px] w-[620px] rounded-full bg-[radial-gradient(circle,rgb(198_255_61/0.14),transparent_65%)]" aria-hidden="true"></div>
    <div class="container-pf grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <nav aria-label="Breadcrumb" class="mb-6 text-xs text-muted"><ol class="flex gap-1.5"><li><a href="/" class="hover:text-primary">Home</a></li><li aria-hidden="true">/</li><li aria-current="page" class="text-ink/80">Contact</li></ol></nav>
        <p class="mb-5 inline-flex items-center gap-2 rounded-pill border border-white/15 bg-white/5 px-3.5 py-1.5 text-sm"><span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-75"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span></span> Coaches online · reply within 24 h</p>
        <h1 data-fx="words" class="font-display text-[clamp(2.8rem,7vw,6.5rem)] font-bold leading-[0.92] tracking-[-0.04em]">Let's talk. <span class="text-primary">👋</span></h1>
        <p class="mt-6 max-w-lg text-lg text-ink/75">Questions about coaching, diet plans or which service fits you? Send a message or book a free call. A real person will get back to you.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#form" data-fx="magnetic" class="btn-primary">Send a message <Icon name="arrow-down" size={16} /></a>
          <a href={wa} target="_blank" rel="noopener" class="btn-secondary">💬 WhatsApp us</a>
        </div>
      </div>
      <div class="relative mx-auto h-[320px] w-full max-w-[520px] sm:h-[420px] lg:col-span-6 lg:h-[500px]" data-fx="stack" style="perspective: 1200px;" aria-hidden="true">
        <div data-depth="0.6" class="absolute right-[6%] top-0 h-[74%] w-[70%] overflow-hidden rounded-[28px] shadow-2xl shadow-black/60 ring-1 ring-white/10">
          <Image src={videoCall} alt="" widths={[400, 700]} sizes="360px" quality={68} loading="eager" class="h-full w-full object-cover" />
        </div>
        <div data-depth="1.2" class="absolute bottom-[6%] left-0 h-[42%] w-[44%] -rotate-6 overflow-hidden rounded-[22px] border-4 border-night shadow-2xl shadow-black/60">
          <Image src={laptops} alt="" widths={[300, 500]} sizes="230px" quality={66} class="h-full w-full object-cover" />
        </div>
        <div data-depth="1.6" class="absolute bottom-0 right-0 h-[34%] w-[34%] rotate-[8deg] overflow-hidden rounded-[22px] border-4 border-night shadow-2xl shadow-black/60">
          <Image src={stethoscope} alt="" widths={[300, 500]} sizes="180px" quality={66} class="h-full w-full object-cover" />
        </div>
        <span data-depth="2" class="chip-glass absolute left-[4%] top-[10%] z-10">💬 “Hi coach!”</span>
        <span data-depth="2.4" class="chip-glass absolute right-[-2%] top-[48%] z-10">✅ Plan ready</span>
        <span data-depth="2.2" class="chip-glass absolute bottom-[46%] left-[10%] z-10">📹 Free call</span>
      </div>
    </div>
  </section>

  <!-- Contact methods -->
  <section class="relative pb-20">
    <div class="container-pf">
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-fx="rise">
        {methods.map((m) => (
          <li data-fx-item>
            {m.href ? (
              <a href={m.href} target={m.ext ? '_blank' : undefined} rel={m.ext ? 'noopener' : undefined} data-fx="tilt" class="group flex h-full flex-col gap-8 rounded-[24px] border border-line bg-surface p-6 transition-colors hover:border-primary/60">
                <span class="flex items-center justify-between"><span class="text-4xl transition-transform duration-500 group-hover:-rotate-12 group-hover:scale-110">{m.e}</span><span class="grid h-10 w-10 place-items-center rounded-full bg-surface-2 text-primary transition-colors group-hover:bg-primary group-hover:text-night"><Icon name="arrow-up-right" size={16} /></span></span>
                <span><span class="block font-display text-xl font-bold">{m.t}</span><span class="text-sm text-muted">{m.d}</span><span class="mt-3 block break-all font-semibold text-ink group-hover:text-primary">{m.v}</span></span>
              </a>
            ) : (
              <div data-fx="tilt" class="flex h-full flex-col gap-8 rounded-[24px] border border-primary/30 bg-primary/10 p-6">
                <span class="text-4xl">{m.e}</span>
                <span><span class="block font-display text-xl font-bold">{m.t}</span><span class="text-sm text-muted">{m.d}</span><span class="mt-3 block font-semibold text-primary">{m.v}</span></span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Form + what happens next -->
  <section id="form" class="relative scroll-mt-24 bg-surface/40 py-24 md:py-32">
    <div class="container-pf grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow mb-4">(What happens next)</p>
        <h2 data-fx="words" class="font-display text-[clamp(2.2rem,5vw,4rem)] font-bold leading-[0.98] tracking-[-0.03em]">Three simple steps.</h2>
        <ol class="mt-10 space-y-4" data-fx="rise">
          {next.map((n, i) => (
            <li data-fx-item class="flex gap-4 rounded-[22px] border border-line bg-night/60 p-5">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-surface-2 text-2xl">{n.e}</span>
              <div><p class="font-display text-lg font-bold"><span class="mr-2 text-primary">0{i + 1}</span>{n.t}</p><p class="mt-1 text-sm text-muted">{n.d}</p></div>
            </li>
          ))}
        </ol>
        <div class="mt-8 hidden aspect-[16/10] overflow-hidden rounded-[24px] lg:block" data-fx="clip">
          <Image src={videoCall} alt="Laptop showing a group video call next to a mug" widths={[500, 800]} sizes="35vw" quality={64} class="h-full w-full object-cover" />
        </div>
      </div>
      <div class="rounded-[28px] border border-line bg-surface p-6 shadow-2xl shadow-black/40 md:p-10 lg:col-span-7">
        <p class="eyebrow mb-2">(Free consultation)</p>
        <h2 class="mb-6 font-display text-3xl font-bold tracking-tight md:text-4xl">Tell us about you.</h2>
        <InquiryForm id="contact-page" />
      </div>
    </div>
  </section>

  <FAQ items={faq} heading="Before you write." id="contact-faq" />
</MarketingLayout>

<script>
  import { initFx } from '../scripts/fx';
  initFx();
</script>
