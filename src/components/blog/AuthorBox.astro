---
import type { PostAuthor } from '../../lib/posts';
interface Props { author: PostAuthor; reviewer?: string }
const { author, reviewer } = Astro.props;
const initials = author.name.split(' ').map((w) => w[0]).slice(0, 2).join('');
---
<section class="mt-12 rounded-[22px] border border-[#E6E8EC] bg-paper-2 p-6 md:p-7" aria-label="About the author">
  <div class="flex items-start gap-4">
    {author.avatar ? <img src={author.avatar} alt="" width="56" height="56" class="h-14 w-14 rounded-full object-cover" loading="lazy" /> : <span class="grid h-14 w-14 shrink-0 place-items-center rounded-full bg-night font-display text-lg font-bold text-primary">{initials}</span>}
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.15em] text-text-muted">Written by</p>
      <p class="mt-1 font-display text-lg font-bold text-text">{author.name}</p>
      {author.credentials && <p class="text-sm font-medium text-text">{author.credentials}</p>}
      {author.bio && <p class="mt-2 text-sm leading-relaxed text-text-muted">{author.bio}</p>}
      {reviewer && <p class="mt-3 inline-flex items-center gap-2 rounded-pill bg-white px-3 py-1 text-xs font-semibold text-text ring-1 ring-[#E6E8EC]">✅ Medically reviewed by {reviewer}</p>}
    </div>
  </div>
</section>
