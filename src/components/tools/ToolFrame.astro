---
/** Two-panel tool layout: inputs (left) + live result (right). */
interface Props { title?: string }
const { title = 'Your details' } = Astro.props;
---
<div class="tool-frame grid gap-4 lg:grid-cols-[1.05fr_1fr] lg:gap-5">
  <form class="tool-form glass-tool rounded-[28px] p-5 md:p-7" novalidate>
    <p class="mb-4 font-display text-sm font-semibold uppercase tracking-[0.18em] text-muted">{title}</p>
    <slot name="form" />
  </form>
  <div class="tool-result relative overflow-hidden rounded-[28px] border border-primary/25 bg-[linear-gradient(160deg,rgb(198_255_61/0.10),rgb(23_25_30/0.9)_45%)] p-5 md:p-7" aria-live="polite">
    <slot name="result" />
  </div>
</div>

<style>
  .glass-tool { background: rgb(23 25 30 / 0.78); border: 1px solid rgb(255 255 255 / 0.09); box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7); }
  @media (min-width: 768px) { .glass-tool { backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); } }
</style>
