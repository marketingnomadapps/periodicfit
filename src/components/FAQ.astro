---
/**
 * Sitewide FAQ with its own parallax: drifting "?" glyphs at different depths, a sliding
 * outlined FAQ label, a sticky side with a scroll-progress ring, and question cards that
 * cascade in (lower cards lag behind and flatten from a tilt). Smooth accordion on open.
 * Uses <details> so it works without JavaScript. FAQPage JSON-LD included.
 */
import Icon from './Icon.astro';
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
  eyebrow?: string;
  id?: string;
  schema?: boolean;
}
const { items, heading = 'Questions, answered.', eyebrow = '(FAQ)', id = 'faq', schema = true } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
const total = String(items.length).padStart(2, '0');
const C = 2 * Math.PI * 44;
---
<section id={id} data-section-bg="#121418" class="faq-x relative isolate overflow-hidden py-24 md:py-36">
  <!-- Parallax decoration -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <span data-faq-depth="1.6" class="absolute -left-6 top-[8%] font-display text-[40vw] font-bold leading-none text-transparent md:text-[22vw]" style="-webkit-text-stroke:1px rgb(198 255 61 / 0.10)">?</span>
    <span data-faq-depth="0.8" class="absolute right-[4%] top-[30%] font-display text-[28vw] font-bold leading-none text-transparent md:text-[14vw]" style="-webkit-text-stroke:1px rgb(244 245 247 / 0.07)">?</span>
    <span data-faq-depth="2.2" class="absolute bottom-[4%] left-[40%] font-display text-[20vw] font-bold leading-none text-transparent md:text-[10vw]" style="-webkit-text-stroke:1px rgb(255 107 44 / 0.12)">?</span>
    <div data-faq-depth="1.2" class="absolute -right-32 top-10 h-96 w-96 rounded-full bg-[radial-gradient(circle,rgb(198_255_61/0.10),transparent_70%)]"></div>
  </div>
  <div class="overflow-hidden" aria-hidden="true">
    <p data-faq-label class="mb-10 select-none whitespace-nowrap font-display text-[20vw] font-bold leading-[0.85] tracking-[-0.05em] text-transparent md:mb-14 md:text-[11vw]" style="-webkit-text-stroke:1px rgb(244 245 247 / 0.10)">FAQ ✦ Questions ✦ Answers ✦ FAQ</p>
  </div>

  <div class="container-pf grid gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-28">
        <p class="eyebrow mb-4">{eyebrow}</p>
        <h2 class="faq-title font-display text-[clamp(2rem,4.2vw,3.5rem)] font-bold leading-[1] tracking-[-0.03em] [overflow-wrap:anywhere] [text-wrap:balance]">{heading}</h2>
        <p class="mt-5 max-w-xs text-muted">Still unsure? <a href="/contact" data-open-inquiry class="text-primary underline underline-offset-4">Ask a coach</a>, it's free.</p>
        <div class="mt-8 flex items-center gap-4">
          <svg class="h-20 w-20 -rotate-90" viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="44" fill="none" stroke="rgb(255 255 255 / 0.08)" stroke-width="6" />
            <circle data-faq-ring cx="50" cy="50" r="44" fill="none" stroke="#C6FF3D" stroke-width="6" stroke-linecap="round" stroke-dasharray={C} stroke-dashoffset={C} />
          </svg>
          <p class="text-sm text-muted"><span class="block font-display text-3xl font-bold text-ink">{total}</span>questions</p>
        </div>
      </div>
    </div>

    <div class="faq-list space-y-3 lg:col-span-8 [perspective:1200px]">
      {items.map((item, i) => (
        <details class="faq-card group rounded-[22px] border border-line bg-surface/80 transition-[border-color,background-color,box-shadow] duration-300 open:border-primary/60 open:bg-surface-2 open:shadow-[0_20px_50px_-25px_rgb(198_255_61/0.35)]" data-i={i}>
          <summary class="flex cursor-pointer list-none items-center gap-4 p-5 md:gap-5 md:p-6 [&::-webkit-details-marker]:hidden">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-night font-display text-sm font-bold text-primary transition-colors group-open:bg-primary group-open:text-night">{String(i + 1).padStart(2, '0')}</span>
            <span class="min-w-0 flex-1 font-display text-base font-semibold leading-snug md:text-lg">{item.q}</span>
            <span class="faq-icon grid h-9 w-9 shrink-0 place-items-center rounded-full border border-line transition-[transform,background-color,border-color,color] duration-500 ease-out-expo group-open:rotate-45 group-open:border-primary group-open:bg-primary group-open:text-night" aria-hidden="true"><Icon name="plus" size={16} /></span>
          </summary>
          <div class="faq-panel overflow-hidden">
            <p class="faq-answer max-w-2xl px-5 pb-6 pl-[4.75rem] leading-relaxed text-ink/75 md:px-6 md:pl-[5.25rem]">{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.faq-x:not([data-ready])').forEach((root) => {
    root.dataset.ready = '';
    const cards = Array.from(root.querySelectorAll<HTMLDetailsElement>('.faq-card'));

    // Smooth, exclusive accordion
    const animate = (card: HTMLDetailsElement, open: boolean) => {
      const panel = card.querySelector<HTMLElement>('.faq-panel')!;
      const answer = card.querySelector<HTMLElement>('.faq-answer')!;
      if (reduce) { card.open = open; return; }
      gsap.killTweensOf([panel, answer]);
      if (open) {
        card.open = true;
        gsap.fromTo(panel, { height: 0 }, { height: 'auto', duration: 0.55, ease: 'expo.out' });
        gsap.fromTo(answer, { y: 14, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, ease: 'power3.out', delay: 0.05 });
      } else {
        gsap.to(panel, { height: 0, duration: 0.4, ease: 'power3.inOut', onComplete: () => { card.open = false; gsap.set(panel, { clearProps: 'height' }); } });
      }
    };
    cards.forEach((card) => {
      card.querySelector('summary')!.addEventListener('click', (e) => {
        e.preventDefault();
        const willOpen = !card.open;
        if (willOpen) cards.forEach((c) => { if (c !== card && c.open) animate(c, false); });
        animate(card, willOpen);
      });
    });

    if (reduce) return;
    const mobile = matchMedia('(max-width: 767px)').matches;
    const k = mobile ? 0.6 : 1;

    // Decoration parallax
    root.querySelectorAll<HTMLElement>('[data-faq-depth]').forEach((el) => {
      const d = Number(el.dataset.faqDepth || 1);
      gsap.fromTo(el, { y: 120 * d * k, rotate: -8 * d }, { y: -120 * d * k, rotate: 8 * d, ease: 'none', scrollTrigger: { refreshPriority: -1, trigger: root, start: 'top bottom', end: 'bottom top', scrub: true } });
    });
    const label = root.querySelector('[data-faq-label]');
    if (label) gsap.fromTo(label, { xPercent: 0 }, { xPercent: -30 * k, ease: 'none', scrollTrigger: { refreshPriority: -1, trigger: root, start: 'top bottom', end: 'bottom top', scrub: true } });

    // Progress ring fills while you read through the list
    const ring = root.querySelector<SVGCircleElement>('[data-faq-ring]');
    const list = root.querySelector('.faq-list');
    if (ring && list) {
      const len = Number(ring.getAttribute('stroke-dasharray'));
      gsap.fromTo(ring, { strokeDashoffset: len }, { strokeDashoffset: 0, ease: 'none', scrollTrigger: { refreshPriority: -1, trigger: list, start: 'top 75%', end: 'bottom 55%', scrub: true } });
    }

    // Cascade: each card tilts up from below; lower cards lag a little more
    cards.forEach((card, i) => {
      gsap.fromTo(card,
        { y: (70 + i * 22) * k, rotateX: 22, scale: 0.96, transformOrigin: '50% 100%' },
        { y: 0, rotateX: 0, scale: 1, ease: 'power2.out', scrollTrigger: { refreshPriority: -1, trigger: card, start: 'top bottom', end: 'top 70%', scrub: 0.6 } });
    });
  });
</script>
