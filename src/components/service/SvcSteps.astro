---
import type { ServiceContent } from '../../data/services';
interface Props { content: ServiceContent }
const { content } = Astro.props;
---
<section id="steps" class="relative py-24 md:py-36">
  <div class="container-pf">
    <div class="mb-16 text-center">
      <p class="eyebrow mb-4">(How it works)</p>
      <h2 class="svc-heading mx-auto max-w-3xl text-[clamp(2.2rem,5.5vw,4.5rem)] font-bold leading-[0.98] tracking-[-0.03em]">From first message to first result.</h2>
    </div>

    <div class="tl relative mx-auto max-w-5xl">
      <!-- Line -->
      <div class="absolute bottom-0 left-5 top-0 w-0.5 bg-line md:left-1/2 md:-translate-x-1/2" aria-hidden="true">
        <div class="tl-fill h-full w-full origin-top bg-primary [.js-motion_&]:scale-y-0"></div>
      </div>
      <ol class="space-y-14 md:space-y-24">
        {content.steps.map((s, i) => (
          <li class:list={['tl-step relative pl-16 md:grid md:grid-cols-2 md:gap-16 md:pl-0', i % 2 === 1 && 'md:[&>.tl-card]:col-start-2']} data-side={i % 2 ? 'right' : 'left'}>
            <span class="tl-dot absolute left-5 top-6 z-10 grid h-11 w-11 -translate-x-1/2 place-items-center rounded-full border-4 border-night bg-primary font-display text-sm font-bold text-night md:left-1/2">{i + 1}</span>
            <div class:list={['tl-card rounded-[24px] border border-line bg-surface p-6 md:p-8', i % 2 === 0 ? 'md:text-right' : '']}>
              <p class="font-display text-xs uppercase tracking-[0.2em] text-primary">Step {String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-3 font-display text-2xl font-bold md:text-3xl">{s.title}</h3>
              <p class="mt-3 text-muted">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
