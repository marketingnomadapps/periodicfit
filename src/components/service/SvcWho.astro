---
import Icon from '../Icon.astro';
import type { ServiceContent } from '../../data/services';
interface Props { content: ServiceContent; name: string }
const { content, name } = Astro.props;
---
<section id="who" class="relative py-24 md:py-36">
  <div class="container-pf">
    <div class="mb-14 max-w-3xl">
      <p class="eyebrow mb-4">(Who it's for)</p>
      <h2 class="svc-heading text-[clamp(2.2rem,5.5vw,4.5rem)] font-bold leading-[0.98] tracking-[-0.03em]">Made for people like you.</h2>
      <p class="mt-5 max-w-lg text-muted">{name} works best if any of these sound familiar.</p>
    </div>
    <ul class="who-deck grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {content.who.map((w, i) => (
        <li class="who-card group relative overflow-hidden rounded-[24px] border border-line bg-surface p-6 transition-[border-color,transform] duration-500 ease-out-expo hover:-translate-y-2 hover:border-primary/60 md:p-7">
          <span class="pointer-events-none absolute -right-3 -top-6 font-display text-[7rem] font-bold leading-none text-white/[0.04]" aria-hidden="true">{i + 1}</span>
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-primary text-night transition-transform duration-500 ease-out-expo group-hover:rotate-[-8deg] group-hover:scale-110"><Icon name={w.icon} size={22} /></span>
          <h3 class="mt-10 font-display text-xl font-bold">{w.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{w.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
