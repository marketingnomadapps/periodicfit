---
import PostImage from './PostImage.astro';
import type { Post } from '../../lib/posts';
interface Props { post: Post; large?: boolean }
const { post, large = false } = Astro.props;
const date = post.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<article class="post-card group h-full" data-title={post.title.toLowerCase()} data-text={`${post.excerpt} ${post.category.name} ${post.tags.join(' ')}`.toLowerCase()}>
  <a href={`/blog/${post.slug}`} class="flex h-full flex-col overflow-hidden rounded-[22px] border border-[#E6E8EC] bg-white transition-[box-shadow,transform] duration-300 hover:-translate-y-1 hover:shadow-[0_20px_40px_-20px_rgb(14_15_18/0.25)]">
    <div class:list={['relative overflow-hidden bg-paper-2', large ? 'aspect-[16/9]' : 'aspect-[16/10]']}>
      {post.image && <PostImage image={post.image} sizes={large ? '(min-width: 1024px) 60vw, 100vw' : '(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw'} eager={large} class="h-full w-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-105" />}
      <span class="absolute left-4 top-4 rounded-pill bg-night/85 px-3 py-1 text-xs font-semibold text-primary">{post.category.name}</span>
    </div>
    <div class="flex flex-1 flex-col p-5 md:p-6">
      <h3 class:list={['font-display font-bold leading-snug tracking-tight text-text group-hover:underline group-hover:decoration-primary group-hover:decoration-[3px] group-hover:underline-offset-4', large ? 'text-2xl md:text-4xl' : 'text-lg md:text-xl']}>{post.title}</h3>
      <p class:list={['mt-2 text-text-muted', large ? 'text-base md:text-lg' : 'line-clamp-2 text-sm']}>{post.excerpt}</p>
      <p class="mt-auto pt-4 text-xs text-text-muted">{post.author.name} · <time datetime={post.date.toISOString()}>{date}</time> · {post.readingTime} min read</p>
    </div>
  </a>
</article>
